# Copie para .env e preencha com os valores reais
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"

# Credenciais do admin inicial (usadas pelo script de seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Segredo para assinar os JWTs (gere um aleatório longo)
JWT_SECRET=""

# URL do front para whitelist de CORS em desenvolvimento
FRONTEND_URL="http://localhost:5173"

NODE_ENV="development"
